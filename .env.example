# Database
DATABASE_URL=mysql://root:root@mysql:3306/hovod
REDIS_URL=redis://redis:6379
PORT=3000

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=hovod-vod
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/hovod-vod
# Set to false for Cloudflare R2 or S3 buckets with ACLs disabled (Object Ownership = bucket owner enforced).
# When false, playback/ objects must be made publicly readable at the bucket level instead.
# S3_PUBLIC_ACL=true

# Shared upload directory (API writes, Worker reads — must be same volume)
# UPLOAD_DIR=/data/uploads
# Worker scratch directory for transcoding (needs ~3x the source size free; default: OS temp dir / TMPDIR)
# WORK_DIR=/data/tmp

# Public URL & CORS
# APP_URL is the public base URL of the deployment (embed/share links, emails,
# Stripe return URLs). With `docker compose up` the API serves the dashboard on
# http://localhost:3002. DASHBOARD_URL is still honoured as a deprecated alias.
# VITE_API_BASE_URL is only used by `npm run dev -w @hovod/dashboard` (port 3001).
APP_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002,http://localhost:3001
VITE_API_BASE_URL=http://localhost:3000

# Security — REQUIRED
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Optional pepper for API-key hashes (defaults to JWT_SECRET). Set it so JWT_SECRET
# can be rotated without invalidating every issued API key — changing API_KEY_SECRET
# itself invalidates all existing keys.
# API_KEY_SECRET=generate-with-openssl-rand-hex-32

# ─── Registration (optional — open by default) ─────────
# REGISTRATION_ENABLED=true                  # set to false to disable new signups
# REGISTRATION_ALLOWED_DOMAINS=example.com   # comma-separated list of allowed email domains

# Docker Compose (development stack) credentials and host ports
# MYSQL_ROOT_PASSWORD=root
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# API_PORT=3002                   # host port for the API + dashboard

# ─── Scaling (optional — auto-detected from hardware) ────
# WORKER_CONCURRENCY=2            # concurrent transcode jobs (default: auto from CPU/RAM)
# FFMPEG_THREADS=4                # threads per FFmpeg process (default: auto from CPU/concurrency)
# DB_POOL_SIZE=20                 # MySQL connection pool size (default: auto from RAM)
# ANALYTICS_RETENTION_DAYS=400    # Playback sessions older than this are purged daily

# ─── AI Processing (optional — omit to disable) ─────────
# Whisper-compatible transcription API (OpenAI, Groq, local, etc.)
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# LLM for chapter generation (openai | anthropic | groq | custom)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_API_URL=                  # custom endpoint (leave empty for default)
#
# Groq example:
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# AI_ENABLED=true               # set to false to disable AI even if configured

# ─── Email (optional in self-host — Resend, https://resend.com) ──
# With email configured, invitations and password-reset links are sent by mail.
# Without it, invitations are link-only (shown to the inviter) and password resets
# are issued from the CLI: `node apps/api/dist/cli.js reset-password <email>`
# (`docker exec hovod hovod-cli reset-password <email>` in the image).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Hovod <no-reply@example.com>

# ─── Cloud mode (leave unset for self-host: unlimited, no Stripe) ──
# HOVOD_CLOUD=true turns Hovod into a paid-only service: signup starts a Stripe
# Checkout, every org needs an active subscription, plan limits are enforced.
# All of the variables below (plus RESEND_API_KEY / EMAIL_FROM) are then required —
# the API refuses to boot half-configured. See docs/cloud.md.
# HOVOD_CLOUD=true
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

# ─── Webhooks (optional) ────────────────────────────────
# WEBHOOK_URL=https://your-app.com/webhook
